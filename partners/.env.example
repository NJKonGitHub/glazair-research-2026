# Browser-side token verification secret (Vite exposes VITE_ prefixed vars to the bundle)
# Must match PORTAL_TOKEN_SECRET used by scripts/generate-token.js
VITE_PORTAL_TOKEN_SECRET=your-secret-here

# Analytics endpoint — Google Apps Script web app URL (optional)
# If not set, all analytics calls are silently skipped.
# Obtain after deploying scripts/analytics-endpoint.gs as a Web App.
VITE_ANALYTICS_ENDPOINT=
